# Google Analytics Measurement ID (GA4)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Feedback Form URL
VITE_FEEDBACK_FORM_URL=https://forms.gle/your-feedback-form-id

# Environment Mode ('dev' for instant browser PDF download, 'prod' for email dispatch modal)
VITE_ENV=dev

# Sendinblue / Brevo Transactional Email API Key (Netlify Environment Variable)
BREVO_API_KEY=your-brevo-v3-api-key
